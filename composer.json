{
    "name": "academic/publication-viewer",
    "description": "Academic Publication Viewer - BibTeX/RIS file manager for research projects",
    "type": "project",
    "require": {
        "php": "^8.1",
        "renanbr/bibtex-parser": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
